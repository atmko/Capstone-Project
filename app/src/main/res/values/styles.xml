<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:textColorSecondary">@android:color/white</item>
        <item name="colorPrimary">@color/background</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="splashScreenTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/omw</item>
    </style>

    <style name="AppTheme.ActionBar">
        <!-- Customize your theme here. -->
        <item name="android:textColorSecondary">@android:color/white</item>
    </style>

    <style name="preferences_theme" parent="@style/Theme.AppCompat">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="actionBarStyle">@style/preferences_theme.app_bar_style</item>
        <item name="android:textSize">@dimen/body_text_size</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">@color/color_subtext</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:listDivider">@color/colorAccent</item>
        <item name="android:selectableItemBackground">@color/background</item>
    </style>

    <style name="preferences_theme.app_bar_style" parent="Base.Widget.AppCompat.ActionBar">
        <item name="titleTextStyle">@style/preferences_theme.app_bar_style.title_style</item>
        <item name="background">@color/colorAccent</item>
        <item name="backgroundStacked">@color/colorAccent</item>
        <item name="backgroundSplit">@color/colorAccent</item>
    </style>

    <style name="preferences_theme.app_bar_style.title_style" parent="Base.TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@android:color/black</item>
    </style>

    <style name="Theme.PopupDialog" parent="@style/Theme.AppCompat.Dialog">
        <item name="windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">80%</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="tab_text_style" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/body_text_size</item>
    </style>

    <style name="tab_style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="tabIndicatorColor">@color/colorSecondary</item>
        <item name="tabTextColor">@android:color/white</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabIndicatorHeight">@dimen/indicator_height</item>
    </style>

    <style name="fab_base_style">
        <item name="android:layout_width">@dimen/fab_size</item>
        <item name="android:layout_height">@dimen/fab_size</item>
        <item name="android:layout_gravity">bottom|end</item>
        <item name="android:layout_marginBottom">@dimen/x4_layout_margin</item>
        <item name="android:layout_marginEnd">@dimen/x4_layout_margin</item>
        <item name="android:layout_marginRight">@dimen/x4_layout_margin</item>
    </style>

    <style name="fab_general_style" parent="fab_base_style">
        <item name="fabCustomSize">@dimen/fab_size</item>
        <item name="maxImageSize">@dimen/fab_max_image_size</item>
    </style>

    <style name="fab_detail_style" parent="fab_general_style">

    </style>

    <style name="style_home_list_display_container">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/x1_layout_margin</item>
    </style>

    <style name="home_list_display_heading_style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/x1_layout_margin</item>"
        <item name="android:layout_marginLeft">@dimen/x2_layout_margin</item>
        <item name="android:layout_marginStart">@dimen/x2_layout_margin</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/appbar_headline_text_size</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="style_standard_search_box">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginTop">@dimen/x1_layout_margin</item>
        <item name="android:layout_marginLeft">0dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginRight">@dimen/x1_layout_margin</item>
        <item name="android:layout_marginEnd">@dimen/x1_layout_margin</item>
        <item name="android:layout_marginBottom">@dimen/x1_layout_margin</item>
        <item name="android:hint">@string/search_text_box_hint</item>
        <item name="android:textColorHint">@android:color/white</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:paddingLeft">@dimen/search_box_padding</item>
        <item name="android:paddingStart">@dimen/search_box_padding</item>
        <item name="android:paddingRight">@dimen/search_box_padding</item>
        <item name="android:paddingEnd">@dimen/search_box_padding</item>
        <item name="android:inputType">text</item>
        <item name="android:textCursorDrawable">@drawable/toolbar_search_box_cursor</item>
        <item name="android:background">@null</item>
        <item name="android:imeOptions">actionSearch|flagNoExtractUi|flagNoFullscreen</item>
    </style>

    <style name="radio_button_style">
        <item name="android:paddingTop">@dimen/x1_layout_margin</item>
        <item name="android:paddingLeft">@dimen/x1_layout_margin</item>
        <item name="android:paddingStart">@dimen/x1_layout_margin</item>
        <item name="android:paddingRight">@dimen/x1_layout_margin</item>
        <item name="android:paddingEnd">@dimen/x1_layout_margin</item>
        <item name="android:paddingBottom">@dimen/x1_layout_margin</item>
    </style>

    <style name="ListStyle" parent="android:Widget.ActionButton.Overflow">
        <item name="android:foreground">@drawable/ripple_pressed</item>
        <item name="android:background">@drawable/ic_list_options</item>
    </style>

    <style name="Confirmation_ButtonStyle" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_marginBottom">@dimen/x2_layout_margin</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">@dimen/body_text_size</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:foreground">@drawable/ripple_pressed</item>
    </style>

    <style name="Confirmation_ButtonStyle_End" parent="Confirmation_ButtonStyle">
        <item name="android:layout_marginRight">@dimen/x2_layout_margin</item>
        <item name="android:layout_marginEnd">@dimen/x2_layout_margin</item>
        <item name="android:layout_gravity">end</item>
    </style>

    <style name="Confirmation_ButtonStyle_Start" parent="Confirmation_ButtonStyle">
        <item name="android:layout_marginLeft">@dimen/x2_layout_margin</item>
        <item name="android:layout_marginStart">@dimen/x2_layout_margin</item>
        <item name="android:layout_gravity">start</item>
    </style>

</resources>
