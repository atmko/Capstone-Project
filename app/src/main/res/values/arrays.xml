    <array name="preset_movie_search_titles">
        <!--<item>latest</item>-->
        <item>now playing</item>
        <item>popular</item>
        <item>top rated</item>
        <item>upcoming</item>
    </array>

    <array name="preset_movie_search_urls">
        <item>https://api.themoviedb.org/3/movie/now_playing?api_key={api_key}&amp;language={lang}&amp;page={page}&amp;region={region}</item>
        <item>https://api.themoviedb.org/3/movie/popular?api_key={api_key}&amp;language={lang}&amp;page={page}&amp;region={region}</item>
        <item>https://api.themoviedb.org/3/movie/top_rated?api_key={api_key}&amp;language={lang}&amp;page={page}&amp;region={region}</item>
        <item>https://api.themoviedb.org/3/movie/upcoming?api_key={api_key}&amp;language={lang}&amp;page={page}&amp;region={region}</item>
    </array>

<!--___________________________________________-->

    <array name="preset_tv_search_titles">
        <!--<item>latest</item>-->
        <item>airing today</item>
        <item>on the air</item>
        <item>popular</item>
        <item>top rated</item>
    </array>

    <array name="preset_tv_search_urls">
        <item>https://api.themoviedb.org/3/tv/airing_today?api_key={api_key}&amp;language={lang}&amp;page={page}</item>
        <item>https://api.themoviedb.org/3/tv/on_the_air?api_key={api_key}&amp;language={lang}&amp;page={page}</item>
        <item>https://api.themoviedb.org/3/tv/popular?api_key={api_key}&amp;language={lang}&amp;page={page}</item>
        <item>https://api.themoviedb.org/3/tv/top_rated?api_key={api_key}&amp;language={lang}&amp;page={page}</item>
    </array>

    <array name="manual_search_urls">
        <item>https://api.themoviedb.org/3/search/tv?api_key={api_key}&amp;language={language}&amp;query={query}&amp;page={page}&amp;first_air_date_year={first_air_date_year}</item>
        <item>https://api.themoviedb.org/3/search/movie?api_key={api_key}&amp;language={language}&amp;query={query}&amp;page={page}&amp;include_adult={include_adult}&amp;region={region}&amp;year={year}&amp;primary_release_year={primary_release_year}</item>
        <item>https://api.themoviedb.org/3/search/person?api_key={api_key}&amp;language={language}&amp;query={query}&amp;page={page}&amp;include_adult={include_adult}&amp;region={region}</item>
    </array>

    <array name="details_urls">
        <item>https://api.themoviedb.org/3/tv/{id}?api_key={api_key}&amp;language={language}&amp;append_to_response=credits</item>
        <item>https://api.themoviedb.org/3/movie/{id}?api_key={api_key}&amp;language={language}&amp;append_to_response=credits</item>
        <item></item>
    </array>

