<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <include layout="@layout/details_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </ScrollView>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/colorAccent" />

        <include layout="@layout/details_extras"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

    <include layout="@layout/up_navigation_button" />

    <!--TODO use size 80dp to have similar size to mocks-->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_to_list_fab"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="180dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginRight="32dp"
        android:src="@drawable/ic_fab_add_to_list"
        app:fabCustomSize="70dp"
        app:maxImageSize="28dp"/>

</FrameLayout>
