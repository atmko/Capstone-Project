<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/top_frame_layout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/search_poster_height"
    android:background="@drawable/poster_image_placeholder"
    android:contentDescription="@string/poster_description">

    <TextView
        android:id="@+id/poster_replacement_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/double_layout_margin"
        android:layout_gravity="center"
        tools:text="movie title"
        android:textAlignment="center"
        android:textColor="@android:color/white"/>
</FrameLayout>
