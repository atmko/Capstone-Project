<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/top_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/half_layout_margin"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/top_frame_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_poster_height"
        android:foreground="@drawable/ripple_pressed"
        tools:ignore="UselessParent">

        <ImageView
            android:id="@+id/posterImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/poster_description"
            android:scaleType="center"
            android:src="@drawable/ic_discover_white"
            android:focusable="false"/>

    </FrameLayout>

</LinearLayout>