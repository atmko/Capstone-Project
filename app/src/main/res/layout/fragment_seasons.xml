<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".Fragments.SeasonsFragment">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/indicator_cross_line_height"
            android:layout_marginBottom="@dimen/indicator_cross_line_margin_from_bottom"
            android:layout_gravity="bottom"
            android:background="@color/colorAccent"/>

        <com.google.android.material.tabs.TabLayout
            style="@style/tab_style"
            android:id="@+id/seasons_tab_layout"
            app:tabMode="scrollable">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="season 1"/>

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="season 2"/>
        </com.google.android.material.tabs.TabLayout>

    </FrameLayout>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/details_extra_view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    </androidx.viewpager.widget.ViewPager>

</LinearLayout>