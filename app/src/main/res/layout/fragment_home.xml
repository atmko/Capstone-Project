<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:id="@+id/top_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".MasterActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorAccent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/media_type_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginTop="@dimen/x1_layout_margin"
                    android:layout_marginBottom="@dimen/x1_layout_margin"
                    android:paddingTop="@dimen/x1_layout_margin"
                    android:paddingRight="@dimen/x1_layout_margin"
                    android:paddingEnd="@dimen/x1_layout_margin"
                    android:paddingBottom="@dimen/x1_layout_margin"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    style="@style/TextAppearance.AppCompat.Widget.ActionBar.Title"
                    tools:text="@string/media_type_movies_text"
                    android:textAlignment="textStart"
                    android:textAllCaps="false"
                    android:textColor="@android:color/black"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/spinner_arrow_image_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/x1_layout_margin"
                    android:layout_marginLeft="@dimen/x1_layout_margin"
                    android:layout_marginBottom="@dimen/x1_layout_margin"
                    android:background="@null"
                    android:src="@drawable/ic_spinner_arrow"
                    app:layout_constraintBottom_toBottomOf="@+id/media_type_text_view"
                    app:layout_constraintStart_toEndOf="@id/media_type_text_view"
                    android:contentDescription="@string/content_description_media_type_button"/>

                <Button
                    android:id="@+id/lists_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/x4_layout_margin"
                    android:layout_marginLeft="@dimen/x4_layout_margin"
                    android:layout_marginTop="@dimen/x1_layout_margin"
                    android:padding="@dimen/x1_layout_margin"
                    android:layout_marginBottom="@dimen/x1_layout_margin"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    style="@style/TextAppearance.AppCompat.Widget.ActionBar.Title"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-medium"
                    android:background="@null"
                    android:text="@string/lists_text_literal"
                    android:textColor="@android:color/black"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/spinner_arrow_image_button"
                    app:layout_constraintTop_toTopOf="parent"
                    android:contentDescription="@string/content_description_lists_button"/>

                <ImageButton
                    android:id="@+id/search_image_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="@dimen/x1_layout_margin"
                    android:layout_marginEnd="@dimen/x1_layout_margin"
                    android:layout_marginRight="@dimen/x1_layout_margin"
                    android:layout_marginBottom="@dimen/x1_layout_margin"
                    android:background="@null"
                    android:padding="@dimen/x2_layout_margin"
                    android:src="@drawable/ic_discover"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:contentDescription="@string/content_description_discover_button"/>


            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.gms.ads.AdView
                style="@style/style_home_list_display_container"
                android:id="@+id/banner_ad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                ads:adSize="BANNER"
                ads:adUnitId="@string/ad_test_id" />

            <TextView
                style="@style/home_list_display_heading_style"
                android:text="@string/spotlight_heading_text" />

            <FrameLayout
                style="@style/style_home_list_display_container"
                android:id="@+id/spotlight_container"
                android:layout_height="@dimen/spotlight_poster_height"
                tools:background="@color/color_subtext"/>

            <TextView
                style="@style/home_list_display_heading_style"
                android:id="@+id/upcoming_container_heading"
                tools:text="upcoming" />

            <FrameLayout
                style="@style/style_home_list_display_container"
                android:id="@+id/upcoming_media_container"
                tools:background="@color/color_subtext"/>

            <TextView
                style="@style/home_list_display_heading_style"
                android:id="@+id/ended_container_heading"
                tools:text="ended" />

            <FrameLayout
                style="@style/style_home_list_display_container"
                android:id="@+id/ended_media_container"
                tools:background="@color/color_subtext"/>

            <TextView
                style="@style/home_list_display_heading_style"
                android:id="@+id/undated_container_heading"
                tools:text="undated" />

            <FrameLayout
                style="@style/style_home_list_display_container"
                android:id="@+id/undated_media_container"
                tools:background="@color/color_subtext"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>