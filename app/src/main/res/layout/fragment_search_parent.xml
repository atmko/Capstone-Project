<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/top_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MasterActivity"
    android:background="#232323">

<!--TODO: create UI-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <EditText
            android:id="@+id/search_edit_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginLeft="55dp"
            android:layout_marginStart="55dp"
            android:layout_marginRight="16dp"
            android:layout_marginEnd="16dp"
            android:hint="Search"
            android:textColorHint="@android:color/white"
            android:textColor="@android:color/white"
            android:padding="8dp"
            android:inputType="text"
            android:background="@drawable/background_searchbox"
            android:imeOptions="actionSearch|flagNoExtractUi|flagNoFullscreen" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="0.43dp"
                android:layout_marginBottom="1.45dp"
                android:layout_gravity="bottom"
                android:background="@color/colorAccent"/>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/media_type_tab_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:tabIndicatorColor="@color/colorAccent"
                app:tabTextColor="@android:color/white"
                app:tabIndicatorFullWidth="true"
                app:tabIndicatorHeight="3dp"
                app:tabMode="fixed">

                <!--TODO these are for test purposes only. apply programmatically instead-->
                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="shows"/>

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="movies"/>

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="people"/>
            </com.google.android.material.tabs.TabLayout>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/search_presets_top_layout"
            android:layout_width="match_parent"
            android:layout_height="48dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="0.43dp"
                android:layout_marginBottom="1.45dp"
                android:layout_gravity="bottom"
                android:background="@color/colorAccent"/>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/search_presets_tab_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:tabIndicatorColor="@color/colorAccent"
                app:tabTextColor="@android:color/white"
                app:tabIndicatorFullWidth="true"
                app:tabIndicatorHeight="3dp"
                app:tabMode="scrollable">

                <!--TODO these TabItems are for visualization purposes only. Tabs applied programmatically instead.-->
                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="popular"/>

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="popular"/>

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="top rated"/>

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="upcoming"/>
            </com.google.android.material.tabs.TabLayout>

        </FrameLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/search_results_view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </LinearLayout>

    <include layout="@layout/up_navigation_button" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/manual_search_fab"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginRight="32dp"
        android:src="@drawable/ic_manual_search"
        app:fabCustomSize="70dp"
        app:maxImageSize="28dp"/>

</FrameLayout>