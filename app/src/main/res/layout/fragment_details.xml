<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                layout="@layout/details_main"
                android:id="@+id/include_details_main"
                app:layout_constraintTop_toTopOf="parent" />

            <include
                android:layout_width="match_parent"
                android:layout_height="1296px"
                layout="@layout/details_extras" />

        </LinearLayout>

    </ScrollView>

    <include layout="@layout/up_navigation_button" />

    <!--TODO use size 80dp to have similar size to mocks-->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_to_list_fab"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="180dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginRight="32dp"
        android:src="@drawable/ic_fab_add_to_list"
        app:fabCustomSize="70dp"
        app:maxImageSize="28dp"/>

</FrameLayout>
