<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/title_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:layout_constraintHorizontal_bias="0"
        tools:text="Genre 1"
        android:textSize="@dimen/body_text_size"
        android:textStyle="bold"/>

    <Spinner
        android:id="@+id/spinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/x2_layout_margin"
        android:gravity="center"
        android:paddingTop="@dimen/half_layout_margin"
        android:paddingBottom="@dimen/half_layout_margin"
        android:paddingStart="@dimen/x2_layout_margin"
        android:paddingEnd="@dimen/x2_layout_margin"
        tools:entries="@array/genre_id_value"
        android:layout_marginLeft="@dimen/x2_layout_margin" />

</LinearLayout>
