<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background">

    <!--TODO fix height programmatically-->
    <ImageView
        android:id="@+id/backdrop_image_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/detail_backdrop_placeholder_height"
        tools:layout_height="@dimen/detail_backdrop_placeholder_height"
        android:src="@drawable/backdrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/content_description_backdrop_image"/>

    <Button
        android:id="@+id/trailer_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/x5_layout_margin"
        android:layout_marginLeft="@dimen/x4_layout_margin"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingStart="@dimen/x2_layout_margin"
        android:paddingTop="@dimen/half_layout_margin"
        android:paddingEnd="@dimen/x2_layout_margin"
        android:paddingBottom="@dimen/half_layout_margin"
        android:foreground="@drawable/ripple_pressed"
        android:background="@color/background"
        android:text="@string/detail_trailer_text_title"
        android:textColor="@android:color/white"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/backdrop_image_view"
        app:layout_constraintStart_toStartOf="@+id/backdrop_image_view" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toBottomOf="@id/backdrop_image_view">

        <TextView
            android:id="@+id/title_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/x2_layout_margin"
            android:layout_marginLeft="@dimen/x2_layout_margin"
            android:layout_marginTop="@dimen/x1_layout_margin"
            android:layout_marginEnd="@dimen/x2_layout_margin"
            android:layout_marginRight="@dimen/x2_layout_margin"
            tools:text="Alita Battle Angel"
            android:textColor="@android:color/white"
            android:textSize="@dimen/headline_24_text_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/date_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/x2_layout_margin"
            android:layout_marginLeft="@dimen/x2_layout_margin"
            android:layout_marginTop="@dimen/x1_layout_margin"
            android:textSize="@dimen/caption_12_text_size"
            android:textColor="@color/color_subtext"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_text_view"
            tools:text="2019" />

        <TextView
            android:id="@+id/maturity_rating_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/x2_layout_margin"
            android:layout_marginLeft="@dimen/x2_layout_margin"
            android:layout_marginTop="@dimen/x1_layout_margin"
            android:textSize="@dimen/caption_12_text_size"
            android:textColor="@color/color_subtext"
            app:layout_constraintStart_toEndOf="@+id/date_text_view"
            app:layout_constraintTop_toBottomOf="@+id/title_text_view"
            tools:text="PG-13" />

        <TextView
            android:id="@+id/genre_0_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/x2_layout_margin"
            android:layout_marginLeft="@dimen/x2_layout_margin"
            android:layout_marginTop="@dimen/x1_layout_margin"
            android:textSize="@dimen/caption_12_text_size"
            android:textColor="@color/color_subtext"
            app:layout_constraintStart_toEndOf="@+id/maturity_rating_text_view"
            app:layout_constraintTop_toBottomOf="@+id/title_text_view"
            tools:text="action" />

        <TextView
            android:id="@+id/genre_1_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/x3_layout_margin"
            android:layout_marginLeft="@dimen/x3_layout_margin"
            android:layout_marginTop="@dimen/x1_layout_margin"
            android:textSize="@dimen/caption_12_text_size"
            android:textColor="@color/color_subtext"
            app:layout_constraintStart_toEndOf="@+id/genre_0_text_view"
            app:layout_constraintTop_toBottomOf="@+id/title_text_view"
            tools:text="drama" />

        <TextView
            android:id="@+id/watch_status_shorthand_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x1_layout_margin"
            android:layout_marginStart="@dimen/x2_layout_margin"
            android:layout_marginLeft="@dimen/x4_layout_margin"
            android:background="@drawable/background_searchbox"
            android:paddingStart="@dimen/x1_layout_margin"
            android:paddingTop="@dimen/half_layout_margin"
            android:paddingEnd="@dimen/x1_layout_margin"
            android:paddingBottom="@dimen/half_layout_margin"
            android:text="Tw"
            android:textColor="@android:color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/date_text_view" />

        <TextView
            android:id="@+id/list_counts_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x1_layout_margin"
            android:layout_marginStart="@dimen/x2_layout_margin"
            android:layout_marginLeft="@dimen/x4_layout_margin"
            android:background="@drawable/background_searchbox"
            android:paddingStart="@dimen/x1_layout_margin"
            android:paddingTop="@dimen/half_layout_margin"
            android:paddingEnd="@dimen/x1_layout_margin"
            android:paddingBottom="@dimen/half_layout_margin"
            android:text="5"
            android:textColor="@android:color/white"
            app:layout_constraintStart_toEndOf="@+id/watch_status_shorthand_text"
            app:layout_constraintTop_toBottomOf="@id/date_text_view" />

        <TextView
            android:id="@+id/release_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x1_layout_margin"
            android:layout_marginStart="@dimen/x2_layout_margin"
            android:layout_marginLeft="@dimen/x4_layout_margin"
            android:background="@drawable/background_searchbox"
            android:paddingStart="@dimen/x1_layout_margin"
            android:paddingTop="@dimen/half_layout_margin"
            android:paddingEnd="@dimen/x1_layout_margin"
            android:paddingBottom="@dimen/half_layout_margin"
            tools:text="Unreleased"
            android:textColor="@android:color/white"
            app:layout_constraintStart_toEndOf="@+id/list_counts_text"
            app:layout_constraintTop_toBottomOf="@id/date_text_view" />

        <TextView
            android:id="@+id/user_rating_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x1_layout_margin"
            android:layout_marginStart="@dimen/x2_layout_margin"
            android:layout_marginLeft="@dimen/x4_layout_margin"
            android:background="@drawable/background_searchbox"
            android:paddingStart="@dimen/x1_layout_margin"
            android:paddingTop="@dimen/half_layout_margin"
            android:paddingEnd="@dimen/x1_layout_margin"
            android:paddingBottom="@dimen/half_layout_margin"
            tools:text="7.5"
            android:textColor="@android:color/white"
            app:layout_constraintStart_toEndOf="@+id/release_status_text"
            app:layout_constraintTop_toBottomOf="@id/date_text_view" />

        <ImageButton
            android:id="@+id/share_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x2_layout_margin"
            android:foreground="@drawable/ripple_pressed"
            android:background="@null"
            android:src="@drawable/ic_share_white"
            app:layout_constraintEnd_toEndOf="@+id/share_text_view"
            app:layout_constraintStart_toStartOf="@+id/share_text_view"
            app:layout_constraintTop_toBottomOf="@id/watch_status_shorthand_text"
            android:contentDescription="@string/content_description_share_button"/>

        <ImageButton
            android:id="@+id/rate_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x2_layout_margin"
            android:foreground="@drawable/ripple_pressed"
            android:background="@null"
            android:src="@drawable/ic_rate"
            app:layout_constraintEnd_toEndOf="@+id/rate_text_view"
            app:layout_constraintStart_toStartOf="@+id/rate_text_view"
            app:layout_constraintTop_toBottomOf="@id/watch_status_shorthand_text"
            android:contentDescription="@string/content_description_rate_button"/>

        <!--______________________________________________-->

        <TextView
            android:id="@+id/share_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/x2_layout_margin"
            android:layout_marginLeft="@dimen/x2_layout_margin"
            android:layout_marginTop="@dimen/x2_layout_margin"
            android:text="@string/detail_share_text_title"
            android:textColor="@color/color_subtext"
            android:textSize="@dimen/caption_12_text_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/share_button" />

        <TextView
            android:id="@+id/rate_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/x4_layout_margin"
            android:layout_marginLeft="@dimen/x4_layout_margin"
            android:layout_marginTop="@dimen/x2_layout_margin"
            android:text="@string/detail_rate_text_title"
            android:textColor="@color/color_subtext"
            android:textSize="@dimen/caption_12_text_size"
            app:layout_constraintStart_toEndOf="@+id/share_text_view"
            app:layout_constraintTop_toBottomOf="@id/share_button" />

        <TextView
            android:id="@+id/rating_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/x2_layout_margin"
            android:layout_marginRight="@dimen/x2_layout_margin"
            android:layout_marginBottom="8dp"
            android:background="@drawable/background_box_white"
            android:fontFamily="sans-serif-black"
            android:paddingLeft="@dimen/x1_layout_margin"
            android:paddingTop="2dp"
            android:paddingRight="@dimen/x1_layout_margin"
            android:paddingBottom="2dp"
            android:textColor="@android:color/white"
            android:textSize="@dimen/headline_48_text_size"
            app:layout_constraintBottom_toTopOf="@+id/overView_text_view"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="7.5" />

        <TextView
            android:id="@+id/overView_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/x2_layout_margin"
            android:layout_marginLeft="@dimen/x2_layout_margin"
            android:layout_marginTop="@dimen/x1_layout_margin"
            android:layout_marginEnd="@dimen/x2_layout_margin"
            android:layout_marginRight="@dimen/x2_layout_margin"
            tools:text="Light years from Earth, 26 years after being abducted, Peter Quill finds himself the prime target of a manhunt after discovering an orb wanted by Ronan the Accuser."
            android:textSize="@dimen/body_text_size"
            android:textColor="@android:color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/share_text_view" />

        <ImageButton
            android:id="@+id/show_more_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/x2_layout_margin"
            android:foreground="@drawable/ripple_pressed"
            android:background="@null"
            android:tag="@string/detail_overview_tag_show_less"
            android:src="@drawable/ic_show_more"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/overView_text_view"
            android:contentDescription="@string/content_description_show_more_button"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--TODO use size 80dp to have similar size to mocks-->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        style="@style/fab_detail_style"
        android:id="@+id/add_to_list_fab"
        android:src="@drawable/ic_fab_add_to_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/trailer_button"
        app:layout_constraintTop_toBottomOf="@+id/backdrop_image_view"
        app:layout_constraintBottom_toBottomOf="@id/backdrop_image_view"/>

</androidx.constraintlayout.widget.ConstraintLayout>