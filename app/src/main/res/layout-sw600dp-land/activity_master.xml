<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/top_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MasterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/master_fragments_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:background="@color/design_default_color_primary"
            android:layout_weight="@integer/master_fragment_layout_weight"/>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/colorAccent"/>

        <FrameLayout
            android:id="@+id/detail_fragments_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:background="@color/colorPrimaryDark"
            android:layout_weight="@integer/detail_fragment_layout_weight"/>

    </LinearLayout>

</FrameLayout>