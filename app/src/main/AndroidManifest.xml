<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.atmko.onmywatch">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:name="androidx.multidex.MultiDexApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <receiver android:name=".widget.ListWidgetProvider" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/list_widget_provider_info" />
        </receiver>
        <receiver
            android:name=".utils.NotificationHandler$BootReceiver"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".utils.NotificationHandler$AlarmReceiver" android:exported="false" />
        <receiver android:name=".utils.NotificationHandler$TimeChangedReceiver"  android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
        <service
            android:name=".utils.NoNotifierService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".utils.UpdateNotifierService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".utils.SeriesTracker"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <activity android:name=".LaunchActivity"
            android:launchMode="singleTop"
            android:theme="@style/splashScreenTheme"
            android:screenOrientation="sensorPortrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MasterActivity"
            android:launchMode="singleTop"
            android:exported="false"/>

        <activity
            android:name=".widget.ListWidgetProviderConfigureActivity"
            android:autoRemoveFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=".widget_setup"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ReviewActivity"
            android:launchMode="singleTop"
            android:exported="false"/>
        <activity
            android:name=".CreateListActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PopupDialog"
            android:exported="false"/>
        <activity
            android:name=".RateActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PopupDialog.TouchClose"
            android:exported="false"/>
        <activity
            android:name=".AddToListActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PopupDialog"
            android:exported="false"/>
        <activity
            android:name=".ConfirmationActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PopupDialog.TouchClose"
            android:exported="false"/>
        <activity
            android:name=".RestoreActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PopupDialog.TouchClose"
            android:exported="false"/>
        <activity
            android:name=".SettingsActivity"
            android:label="@string/options_settings_title"
            android:launchMode="singleTop"
            android:theme="@style/preferences_theme"
            android:exported="false"/>
        <activity
            android:name=".BillingActivity"
            android:label="@string/purchases_title"
            android:theme="@style/AppTheme"
            android:exported="false"/>

        <service
            android:name=".widget.ListRemoteViewFactoryService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false"/>
        <service
            android:name=".widget.ListWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".utils.network_utils.work_manager_workers.BackupWorker"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".utils.network_utils.RestoreService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".utils.network_utils.BackupService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>

</manifest>